{
  "expo": {
    "name": "Satellite Tracker",
    "slug": "tp7-satellite-tracker",
    "scheme": "satellitetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.benjaklim.satellitetracker"
    },
    "android": {
      "package": "com.benjaklim.satellitetracker",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to compute satellite azimuth, elevation and visible passes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#38BDF8"
        }
      ],
      "expo-background-task",
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "proxyUrl": "http://10.0.2.2:8787"
    }
  }
}
