{
  "name": "tp7-satellite-tracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.5.1",
    "expo": "~58.0.22",
    "expo-background-task": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-sensors": "~58.0.4",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "satellite.js": "~6.0.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "validate": "tsx scripts/validate.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|expo-modules-core|satellite.js)"
    ]
  }
}
