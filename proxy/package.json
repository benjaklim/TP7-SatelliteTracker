{
  "name": "tp7-satellite-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Credential-holding cache/rate-limit proxy for CelesTrak, Space-Track, N2YO and Where the ISS at?",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
